# PrimeCool — environment variable reference.
# Copy to `.env` (or `.dev.env`) for local dev. NEVER commit your filled file.
# Vars marked REQUIRED are checked by the preflight gate in main.py and will
# refuse to boot the app if missing or invalid.

# ──────────────────────────────────────────────────────────────────────────
# REQUIRED — JWT signing secret. Refuses to boot if missing/weak.
# Must be ≥32 chars with ≥8 distinct characters. No placeholders accepted.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=changeme-generate-with-secrets-token_urlsafe

# REQUIRED — Master key for field-level encryption (AES-GCM + AES-SIV).
# HKDF-derives per-field sub-keys. Must be ≥32 chars.
# ROTATING THIS KEY makes existing ciphertext unreadable — plan a migration.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FIELD_ENCRYPTION_KEY=changeme-generate-with-secrets-token_urlsafe

# REQUIRED in prod (PROD_MODE=true) — explicit operator ack that the
# datastore on disk holds encrypted-at-app-layer PII. Boot refuses without
# this acknowledgement in prod. In dev, leave unset.
# Override (skip the check in prod) with DATASTORE_ENCRYPTION_OVERRIDE=yes.
DATASTORE_ENCRYPTION_CONFIRMED=yes
# DATASTORE_ENCRYPTION_OVERRIDE=yes   # uncomment ONLY for break-glass boots

# ──────────────────────────────────────────────────────────────────────────
# Prod / runtime flags
# PROD_MODE — when "true", tightens preflight checks (e.g. COOKIE_SECURE
# must also be true). Defaults to "false" for local dev.
PROD_MODE=false

# COOKIE_SECURE — set "true" in prod (HTTPS) so auth cookies get the Secure
# attribute. Refused at preflight if PROD_MODE=true and this is false.
COOKIE_SECURE=false

# ──────────────────────────────────────────────────────────────────────────
# Optional — session / auth tuning
# Admin idle-logout seconds (default 1800 = 30 min).
ADMIN_IDLE_TIMEOUT_SEC=1800

# ──────────────────────────────────────────────────────────────────────────
# Optional — boot manifest directory (audit hash-chain anchors at startup).
BOOT_MANIFEST_DIR=boot_manifests

# Optional — delegation verbose audit. "1" (default) writes
# delegation.accessed rows for every delegated record access; "0" suppresses.
DELEGATION_VERBOSE_AUDIT=1

# ──────────────────────────────────────────────────────────────────────────
# Optional — outbound email (Resend). Leave unset to disable email notifies.
RESEND_API_KEY=re_your_api_key_here
NOTIFY_EMAIL=ops@example.com

# ──────────────────────────────────────────────────────────────────────────
# Bootstrap (FIRST BOOT ONLY) — auto-creates a super_admin if no admins
# exist. Remove these vars after the first successful boot.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Super Admin
