# Copy this to .env for local development (never commit .env)
RESEND_API_KEY=re_your_api_key_here
NOTIFY_EMAIL=rjuggar@aol.com
# Long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# If unset, GET /api/submissions returns 503.
ADMIN_TOKEN=replace_with_long_random_string
