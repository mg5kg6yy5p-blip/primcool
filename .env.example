# Copy this to .env for local development (never commit .env)

# --- Database ---
# Local dev: run Postgres in Docker, e.g.
#   docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=primcool postgres:16
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/primcool

# --- Auth ---
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_with_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# --- Admin endpoint (legacy consult submissions) ---
ADMIN_TOKEN=replace_with_long_random_string

# --- Email ---
RESEND_API_KEY=re_your_api_key_here
NOTIFY_EMAIL=ops@primecoolservices.com

# --- CORS ---
# Comma-separated. Defaults to the production domains if unset.
# ALLOWED_ORIGINS=https://primecoolservices.com,https://www.primecoolservices.com
