# ─── Runtime data — never commit ───────────────────────────────────────────
# Local databases — NEVER commit (contain encrypted-at-app-layer PII; chain-hash material)
# Globs are intentionally broad: SQLite spawns -shm/-wal sidecars, and some tools
# produce space-suffixed duplicates (e.g. "submissions.db-shm 2.db-shm") that a bare
# "submissions.db-shm" rule would NOT match.
submissions.db
submissions.db-shm*
submissions.db-wal*
submissions.db.bak-*
submissions.db.before-*

# Editor / scratch backups — never source
*.bak

# Uploads — customer PII, photo evidence
uploads/photos/*
!uploads/photos/.gitkeep
uploads/documents/*/*
!uploads/documents/*/.gitkeep

# Boot manifests — operational artifacts, not source
boot_manifests/

# ─── Env files ─────────────────────────────────────────────────────────────
# Dev env file — contains secrets
.dev.env
.env
.env.local

# ─── Python build artifacts ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
venv/
.venv/

# ─── Local Claude settings ─────────────────────────────────────────────────
.claude/settings.local.json

# ─── IDE / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
dev.env.local
.claude/launch.json
